{
  "$schema": "https://json.schemastore.org/electron-builder",
  "appId": "io.masscode.app",
  "productName": "massCode",
  "directories": {
    "output": "dist"
  },
  "files": [
    "build/renderer/**/*",
    "build/main/**/*",
    "build/shared/**/*",
    "!build/**/*.map",
    "!**/node_modules/onnxruntime-web/**",
    "!**/node_modules/onnxruntime-node/bin/napi-v6/darwin/arm64/libonnxruntime.1.30.0.dylib"
  ],
  "asarUnpack": [
    "node_modules/@lydell/**/*",
    "**/node_modules/onnxruntime-node/**/*",
    "**/node_modules/sharp/**/*",
    "**/node_modules/@img/**/*"
  ],
  "publish": {
    "provider": "github",
    "owner": "massCodeIO",
    "repo": "massCode"
  },
  "mac": {
    "target": ["dmg", "zip"],
    "icon": "build/icons/icon.icns",
    "entitlements": "build/entitlements.mac.inherit.plist",
    "category": "public.app-category.productivity",
    "hardenedRuntime": true,
    "notarize": true,
    "files": [
      "build/renderer/**/*",
      "build/main/**/*",
      "build/shared/**/*",
      "!build/**/*.map",
      "!**/node_modules/onnxruntime-web/**",
      "!**/node_modules/onnxruntime-node/bin/napi-v6/darwin/arm64/libonnxruntime.1.30.0.dylib",
      "!**/node_modules/onnxruntime-node/bin/napi-v6/{linux,win32}/**"
    ]
  },
  "win": {
    "target": ["nsis", "portable"],
    "icon": "build/icons/icon.ico",
    "files": [
      "build/renderer/**/*",
      "build/main/**/*",
      "build/shared/**/*",
      "!build/**/*.map",
      "!**/node_modules/onnxruntime-web/**",
      "!**/node_modules/onnxruntime-node/bin/napi-v6/darwin/arm64/libonnxruntime.1.30.0.dylib",
      "!**/node_modules/onnxruntime-node/bin/napi-v6/{darwin,linux}/**",
      "!**/node_modules/onnxruntime-node/bin/napi-v6/win32/arm64/**"
    ]
  },
  "linux": {
    "target": ["AppImage"],
    "icon": "build/icons/icon.png",
    "files": [
      "build/renderer/**/*",
      "build/main/**/*",
      "build/shared/**/*",
      "!build/**/*.map",
      "!**/node_modules/onnxruntime-web/**",
      "!**/node_modules/onnxruntime-node/bin/napi-v6/darwin/arm64/libonnxruntime.1.30.0.dylib",
      "!**/node_modules/onnxruntime-node/bin/napi-v6/{darwin,win32}/**",
      "!**/node_modules/onnxruntime-node/bin/napi-v6/linux/arm64/**"
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "shortcutName": "massCode",
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "portable": {
    "artifactName": "${productName}-${version}-${arch}-portable.${ext}"
  },
  "protocols": [
    {
      "name": "massCode",
      "schemes": ["masscode"]
    }
  ]
}
